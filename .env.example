# Copy to .env.local for local development. Leave empty to run in preview mode (data stays in the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only (Vercel → Settings → Environment Variables). Never prefix these with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Prana chat (api/chat.js) — server-only. Get the key from Google AI Studio; pick a current Flash model name there.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=your-gemini-model-name-here
CHAT_ENABLED=false
CHAT_DAILY_CAP=800
ALLOWED_ORIGINS=https://sattvaheals.in,https://www.sattvaheals.in
